# ═══════════════════════════════════════════════════════════════════
#  EDA on AWS — Per-environment configuration examples (example.env)
# ═══════════════════════════════════════════════════════════════════
#
# Copy this file to create an environment-specific config:
#   cp config/example.env config/prod.env
#   $EDITOR config/prod.env
#
# Deploy:
#   CONFIG=config/prod.env ./setup.sh
# ═══════════════════════════════════════════════════════════════════


# ─── Example 1: Full configuration (OpenZFS + ONTAP + License Server) ──

REGION="ap-northeast-2"
CLUSTER_NAME="eda-prod"

# Use a unique stack prefix and cluster name for each environment.
# STACK_PREFIX: starts with a letter; letters, digits, hyphens only; max 48.
# e.g. STACK_PREFIX="EdaProd" → EdaProdBase, EdaProdStorage, EdaProdLicenseServer
STACK_PREFIX="Eda"

VPC_ID="vpc-xxxxxxxxxxxxxxxxx"
SUBNET_ID="subnet-xxxxxxxxxxxxxxxxx"

ENABLE_OPENZFS=1
OPENZFS_SIZE_GIB=32768      # 32 TiB
OPENZFS_THROUGHPUT=7680     # 7680 MBps
OPENZFS_IOPS=300000         # below the 307200 IOPS tier maximum

ENABLE_ONTAP=1
ONTAP_SIZE_GIB=40960        # 40 TiB
ONTAP_TPUT_PER_HA=6144      # 6144 MBps per HA pair
ONTAP_HA_PAIRS=2            # total 12 GBps / 400K IOPS

# License Server is always deployed. Defaults model Synopsys SCL/FlexNet.
LICENSE_INSTANCE_TYPE="m7i.large"
LICENSE_MANAGER_PORT=27000       # lmgrd
LICENSE_VENDOR_PORT=27020        # snpslmd (must be fixed in the license file)

ENABLE_LOGIN_NODE=1
ENABLE_DCV=1               # selects a g6.4xlarge Login Node
DCV_ALLOWED_IPS="172.16.4.0/24"
ENABLE_SSM=1

ENABLE_VPC_ENDPOINTS=1

ALARM_EMAIL="ops-team@example.com"


# ─── Example 2: Minimal storage configuration (OpenZFS only) ─────────
#
# CLUSTER_NAME="eda-dev"
# ENABLE_OPENZFS=1
# OPENZFS_SIZE_GIB=16384
# OPENZFS_THROUGHPUT=5120
# OPENZFS_IOPS=200000
# ENABLE_ONTAP=0
# ENABLE_LOGIN_NODE=1


# ─── Example 3: Direct submission from on-prem without Login Node ──
#
# ENABLE_LOGIN_NODE=0
# # Note: requires on-prem Slurm client + same munge.key + matching UID
