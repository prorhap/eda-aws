# AWS PCS deployment configuration.
# Regular PCS commands read only this file or PCS_CONFIG.

##########################################################
# ── Primary deployment inputs: review these for every environment ────────────

# AWS Region and the Shared Foundation prefix used by default.
PCS_REGION="ap-northeast-2"
# Leave these blank to resolve the Foundation VPC/subnet automatically.
# Set either value only to override an existing Foundation value.
PCS_VPC_ID=""
# PCS Cluster, Login CNG, Compute CNG, and the PCS VPC endpoint use this subnet.
PCS_SUBNET_ID=""
# Default: reuse EdbBase, EdbStorage, and EdbLicenseServer CloudFormation outputs.
# Set empty only for a fully standalone deployment with direct values below.
PCS_SHARED_STACK_PREFIX="Eda"

# CNGs and EC2 Name tags become login-<name> and compute-<name>.
# Keep this at 17 characters or fewer to satisfy the PCS CNG name limit.
PCS_CLUSTER_NAME="eda-pcs-cluster"
PCS_STACK_NAME="EdaPcs"

# Seoul-region AWS PCS sample AMI for AL2023, x86_64, and Slurm 25.11.
# This is suitable for PoC use. Production must replace it with a validated
# golden AMI. Re-query the latest sample AMI if this ID is no longer available.
PCS_AMI_ID="ami-07d7716ef5d114faf"

PCS_CLUSTER_SIZE="SMALL"
PCS_SLURM_VERSION="25.11"

PCS_LOGIN_INSTANCE_TYPE="m7i.2xlarge"
PCS_COMPUTE_INSTANCE_TYPES="x8aedz.24xlarge"
PCS_COMPUTE_MIN_COUNT=0
# x8aedz.24xlarge exposes 96 physical cores, 3 TiB RAM, and 7.6 TB local NVMe.
# Nine nodes provide 864 physical cores. Deploy the Foundation and PCS in an AZ
# that offers this type, with OpenZFS in that same AZ.
PCS_COMPUTE_MAX_COUNT=9

PCS_QUEUE_NAME="default-eda-queue"
PCS_PURCHASE_OPTION="ONDEMAND"

PCS_ENABLE_LOGIN_NODE=1
# Login nodes remain private. The closed VPC/VPN network is the access boundary.
PCS_SSH_CIDR="0.0.0.0/0"
# Direct EC2 key pair. Leave blank to reuse Foundation KeyPairName when a
# PCS_SHARED_STACK_PREFIX is set. It is required for SSH in standalone mode.
PCS_KEY_PAIR_NAME=""

# EDA license server access is optional. Leave all direct values empty to reuse
# Foundation CloudFormation outputs, or provide all values for an external server.
PCS_ENABLE_LICENSE_ACCESS=1
PCS_LICENSE_SECURITY_GROUP_ID=""
PCS_LICENSE_MANAGER_PORT=""
PCS_LICENSE_VENDOR_PORT=""

PCS_ENABLE_OPENZFS_MOUNTS=1
# Optional override for an existing FSx for OpenZFS file system. When DNS is
# set and SG is empty, pcs-setup.sh discovers the SG through the file system ENIs.
# When both are empty, PCS reads the Foundation CloudFormation outputs.
PCS_OPENZFS_DNS=""
PCS_OPENZFS_SECURITY_GROUP_ID=""

PCS_ENABLE_ONTAP_MOUNTS=0
# Optional override for an existing FSx for ONTAP SVM. SG auto-discovery and
# Foundation CloudFormation output fallback follows the same rules as OpenZFS.
PCS_ONTAP_SVM_NFS_DNS=""
PCS_ONTAP_SECURITY_GROUP_ID=""

##########################################################
# ── Operational defaults: change only when the platform policy requires it ─

PCS_ALLOW_SAMPLE_AMI=1
PCS_ROOT_DEVICE_NAME="/dev/xvda"

PCS_SPOT_ALLOCATION_STRATEGY="price-capacity-optimized"
# EdbBase does not include SSM Interface Endpoints. Login SSH is the default
# closed-network access path; enable only after adding SSM connectivity.
PCS_ENABLE_SSM=0
PCS_ENABLE_ACCOUNTING=0
PCS_ACCOUNTING_PURGE_DAYS=90
PCS_SCALE_DOWN_IDLE_SECONDS=900

# x8aedz.24xlarge has two 3.8 TB NVMe SSDs. The lifecycle action builds an
# ephemeral RAID 0 XFS filesystem that is removed when a compute node ends.
PCS_ENABLE_LOCAL_SCRATCH=1
PCS_LOCAL_SCRATCH_MOUNT_POINT="/local_scratch"
PCS_ENABLE_CLOUDWATCH_LIFECYCLE_LOGS=1
# These managed-control-plane logs are separate from node lifecycle logs above.
# Audit RPC logging can approach 90% of scheduler log volume, so it is opt-in.
PCS_ENABLE_SCHEDULER_LOG_DELIVERY=1
PCS_ENABLE_JOB_COMPLETION_LOG_DELIVERY=1
PCS_ENABLE_SCHEDULER_AUDIT_LOG_DELIVERY=0
PCS_LOG_RETENTION_DAYS=30
PCS_CREATE_PCS_VPC_ENDPOINT=1

PCS_LOGIN_ROOT_VOLUME_GIB=100
PCS_COMPUTE_ROOT_VOLUME_GIB=200

# ── Shared foundation control: normally leave unchanged ─────────────────────

# Shared foundation changes are performed with explicit foundation-* actions.
# Regular PCS synth/diff/deploy never modifies Base/Storage/LicenseServer.
PCS_FOUNDATION_SCOPE="base"
